// Prisma schema for the running calendar app.
// SQLite does not support native enums, so runType is stored as a String
// and validated at the application layer (Zod).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A profile the app runs "as". This is a lightweight profile selector, not
// authentication: anyone can pick any user from the switcher modal.
model User {
  id        String           @id @default(cuid())
  name      String
  color     String? // hex color used for the avatar/accent in the UI
  createdAt DateTime         @default(now())
  sessions  RunningSession[]
}

model RunningSession {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime
  startTime        String
  endTime          String
  distanceKm       Float
  averageHeartRate Int
  maxHeartRate     Int
  averagePace      String
  maxPace          String
  runType          String
  customRunType    String?
  comment          String?

  // Optional metrics, populated when importing from a Garmin .FIT file.
  // All nullable so manually-entered sessions remain valid.
  externalId       String? // Garmin activity id (from the file name); unique per user
  durationSeconds  Int? // precise elapsed time
  avgCadenceSpm    Int? // steps per minute
  maxCadenceSpm    Int?
  steps            Int?
  calories         Int?
  restingCalories  Int?
  elevationGainM   Int?
  elevationLossM   Int?
  sweatLossMl      Int?
  sport            String?
  subSport         String?
  sportProfileName String?
  numLaps          Int?
  startLat         Float?
  startLng         Float?
  endLat           Float?
  endLng           Float?

  track     SessionTrack?
  laps      SessionLap[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([date])
  @@index([userId, date])
}

// Full second-by-second GPS/sensor track for an imported session, stored as a
// JSON array. Kept in a separate table so the calendar queries never load it.
//
// Point shape: { t, lat, lng, alt, hr, cad, d, v?, pw?, gct?, vo?, sl?, tmp? }.
// The first seven keys are always present (null when unavailable); the optional
// ones are only written when the device actually recorded them, so tracks
// imported before those fields were captured stay valid as-is.
model SessionTrack {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   RunningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  points    String // JSON array of track points, see above
  createdAt DateTime       @default(now())
}

// One lap ("circuit") as recorded by the watch. Persisted verbatim from the FIT
// lap messages so the splits table can show the device's own boundaries rather
// than recomputed ones. Everything is nullable: which fields a lap carries
// depends on the watch and the sensors paired with it.
model SessionLap {
  id        String         @id @default(cuid())
  sessionId String
  session   RunningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lapIndex  Int // 1-based, in recording order

  startOffsetS  Int? // seconds between the session start and the lap start
  totalTimerS   Float?
  totalElapsedS Float?
  totalMovingS  Float?
  distanceM     Float?

  avgSpeedMps Float?
  maxSpeedMps Float?

  avgHeartRate Int?
  maxHeartRate Int?
  minHeartRate Int?

  avgCadenceSpm Int?
  maxCadenceSpm Int?
  steps         Int?

  calories Int?
  ascentM  Int?
  descentM Int?

  avgPower        Int?
  maxPower        Int?
  normalizedPower Int?

  avgStanceTimeMs      Float?
  avgStanceTimeBalance Float? // % on the left foot
  avgVerticalOscMm     Float?
  avgStepLengthMm      Float?
  avgVerticalRatio     Float?

  avgTemperature Float?
  maxTemperature Float?
  avgAltitudeM   Float?

  startLat Float?
  startLng Float?
  endLat   Float?
  endLng   Float?

  lapTrigger String? // e.g. "distance" (auto-lap) vs "manual"
  intensity  String?

  createdAt DateTime @default(now())

  @@unique([sessionId, lapIndex])
  @@index([sessionId])
}
